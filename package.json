{
  "name": "oddkin-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.9",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "build": "node --check src/index.js && node --check src/models/Subscriber.js && node --check src/services/dailyDigest.js && node --check src/scripts/exportSubscribers.js",
    "export:subscribers": "node src/scripts/exportSubscribers.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^4.21.2",
    "express-rate-limit": "^8.0.1",
    "mongoose": "^8.19.1",
    "node-cron": "^4.2.1",
    "nodemailer": "^7.0.9"
  }
}
